# model 1: bowed, two notes held 0.4 s
blocks 2000
set perf.note 48.0
set perf.strength 0.8
set perf.modulation 0.0
set part.model 1
set patch.exciter_bow_level 1.0
set patch.exciter_strike_level 0.0
at 0 perf.note 43
at 0 perf.gate 1
at 750 perf.gate 0
at 1000 perf.note 55
at 1000 perf.gate 1
at 1750 perf.gate 0
